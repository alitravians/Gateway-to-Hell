    local rightHorn = createPart("DemonHornR", Vector3.new(1.0, 4.2, 1.0), CFrame.new(43.9, 14.5, 1.1) * CFrame.Angles(0, 0, math.rad(26)), darkColor, Enum.Material.Slate, parent, true, true, 0, true)
