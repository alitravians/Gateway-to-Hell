    local legs = createPart("DemonLegs", Vector3.new(4.6, 7.2, 3.0), CFrame.new(44.0, 2.0, 0), darkColor, Enum.Material.Slate, parent, true, true, 0, true)
    legs.Shape = Enum.PartType.Block
