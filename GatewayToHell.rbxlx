}

GameConfig.PLACEHOLDER_BADGE_IDS = {
    FirstEscape = 0,
    NoDeathsEscape = 0,
    NightmareClear = 0,
    HardcoreClear = 0,
    SecretEnding = 0,
}

GameConfig.ENDING_LINES = {
    Good = {
        TitleAr = "نهاية النجاة",
        LineAr = "أبواب الجحيم تنحني أمام الناجين، لكن صدى الخطوات ما زال خلفهم.",
    },
    Bad = {
        TitleAr = "النهاية المظلمة",
